{
  "name": "keel-obs",
  "version": "0.1.0",
  "private": true,
  "description": "Keel enterprise agent observability",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/cli.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run --exclude test/seed-minio.integration.test.ts",
    "test:integration": "RUN_MINIO_TESTS=1 vitest run test/seed-minio.integration.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.876.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
